# PostHog, proxied so blockers see a first-party path (api_host in src/components/fundations/head/posthog.astro).
# Asset and config rules come before the catch-all.
/relay/static/*  https://us-assets.i.posthog.com/static/:splat  200!
/relay/array/*   https://us-assets.i.posthog.com/array/:splat   200!
/relay/*         https://us.i.posthog.com/:splat                200!

# One hop from http://www to the apex, instead of http://www -> https://www -> apex.
http://www.danestves.com/*  https://danestves.com/:splat  301!

# Page redirects (PolarSync, /work) live in astro.config.mjs.

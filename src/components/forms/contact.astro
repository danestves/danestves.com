---
// The contact form posts to Netlify Forms (detected at deploy from data-netlify). If that post fails, it falls back
// to opening the visitor's email app with the message written out to hi@danestves.com, so nothing is lost.
// Without JS the browser posts the form itself and Netlify shows its own thank-you page.
---

<div class="shell">
  <header class="page-head">
    <h1>Start a project</h1>
    <div class="page-head__aside">
      <p class="lead">Say what it should do, who it is for, and when it should ship.</p>
    </div>
  </header>

  <div class="section contact">
    <form
      class="contact__form"
      data-mailto="hi@danestves.com"
      data-netlify="true"
      method="POST"
      name="contact"
      netlify-honeypot="bot-field"
      novalidate
    >
      <input name="form-name" type="hidden" value="contact" />
      <p hidden><label>Leave this empty <input name="bot-field" tabindex="-1" /></label></p>
      <div class="field">
        <label for="first-name">First name</label>
        <input autocomplete="given-name" class="input" id="first-name" name="first-name" type="text" />
      </div>
      <div class="field">
        <label for="last-name">Last name</label>
        <input autocomplete="family-name" class="input" id="last-name" name="last-name" type="text" />
      </div>
      <div class="field field--wide">
        <label for="company">Company</label>
        <input autocomplete="organization" class="input" id="company" name="company" type="text" />
      </div>
      <div class="field field--wide">
        <label for="email">Email</label>
        <input autocomplete="email" class="input" id="email" name="email" required type="email" />
      </div>
      <div class="field field--wide">
        <label for="message">What should it do?</label>
        <textarea class="input" id="message" name="message" required rows="6"></textarea>
      </div>
      <div class="contact__send field--wide">
        <button class="btn" type="submit">Send</button>
        <p aria-live="polite" class="contact__help" id="contact-help">It goes to hi@danestves.com.</p>
      </div>
    </form>

    <aside class="contact__direct">
      <dl>
        <div><dt>Email</dt><dd><a href="mailto:hi@danestves.com?subject=A%20project">hi@danestves.com</a></dd></div>
        <div>
          <dt>Company</dt>
          <dd><address>danestves LLC<br />651 N Broad St, Suite 201<br />Middletown, DE 19709, USA</address></dd>
        </div>
      </dl>
    </aside>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const form = document.querySelector<HTMLFormElement>("form[data-mailto]");
    const help = document.getElementById("contact-help");
    if (!form || !help) return;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const invalid = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea")].filter(
        (field) => !field.checkValidity(),
      );
      form.querySelectorAll("[aria-invalid]").forEach((field) => field.removeAttribute("aria-invalid"));
      if (invalid.length) {
        invalid.forEach((field) => field.setAttribute("aria-invalid", "true"));
        help.textContent = "Add your email as name@example.com and a line about the project.";
        invalid[0].focus();
        return;
      }

      const data = new FormData(form);
      const button = form.querySelector("button");
      if (button) button.disabled = true;
      help.textContent = "Sending…";
      const sent = await fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams([...data].map(([key, value]) => [key, String(value)])).toString(),
      })
        .then((res) => res.ok)
        .catch(() => false);
      if (button) button.disabled = false;
      if (sent) {
        form.reset();
        help.textContent = "Sent. You will hear back from hi@danestves.com.";
        return;
      }

      const name = [data.get("first-name"), data.get("last-name")].filter(Boolean).join(" ");
      const company = String(data.get("company") || "");
      const subject = company ? `A project for ${company}` : "A project";
      const body = `${data.get("message")}\n\n${name}\n${data.get("email")}`;
      window.location.href = `mailto:${form.dataset.mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      help.textContent = "The form did not go through, so your email app should open with the message. If it does not, write to hi@danestves.com.";
    });
  });
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-columns);
    row-gap: var(--space-2xl);
    align-items: start;
    padding-top: var(--section-gap-s);
  }
  .contact__form {
    grid-column: 1 / span 7;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--gap-columns);
  }
  .field--wide {
    grid-column: 1 / -1;
  }
  .contact__send {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
  }
  .contact__help {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .contact__direct {
    grid-column: 9 / -1;
  }
  .contact__direct dl {
    display: grid;
    gap: var(--space-md);
  }
  .contact__direct div {
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-rule);
  }
  .contact__direct dt {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .contact__direct dd {
    margin-top: var(--space-2xs);
  }
  .contact__direct address {
    font-style: normal;
  }

  @media (max-width: 60rem) {
    .contact__form,
    .contact__direct {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 40rem) {
    .contact__form {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

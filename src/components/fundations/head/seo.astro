---
import { SEO } from "astro-seo";

interface Props {
  title?: string;
  description?: string;
  /** Appends " | danestves LLC"; the home page keeps its title as is. */
  useTitleTemplate?: boolean;
  /** A landscape share image. Pages without one share the site card. */
  image?: { url: string; alt: string };
  noindex?: boolean;
  /** Posts only: shares the page as an article, with its dates and tags. */
  article?: { publishedTime: Date; modifiedTime?: Date; tags: string[] };
}

const SITE_NAME = "danestves LLC";
// public/og/index.jpg is a 2x capture of the home page hero.
const SITE_CARD = { url: "/og/index.jpg", alt: "danestves LLC, the studio behind Outlayr and Vela", width: 2400, height: 1260 };

const {
  title = "danestves LLC, the app studio of Daniel Esteves",
  description = "danestves LLC is the software studio of Daniel Esteves (danestves). It builds and publishes Outlayr and Vela, and builds iOS, Android and web apps for clients.",
  useTitleTemplate = false,
  image,
  noindex = false,
  article,
} = Astro.props;

const fullTitle = useTitleTemplate ? `${title} | ${SITE_NAME}` : title;
const share = image ?? SITE_CARD;
const shareUrl = new URL(share.url, Astro.site).href;
---

<SEO
  description={description}
  noindex={noindex}
  openGraph={{
    basic: { title: fullTitle, type: article ? "article" : "website", image: shareUrl },
    optional: { description, siteName: SITE_NAME, locale: "en_US" },
    image: { alt: share.alt, ...("width" in share && { width: share.width, height: share.height }) },
    article: article && {
      publishedTime: article.publishedTime.toISOString(),
      modifiedTime: (article.modifiedTime ?? article.publishedTime).toISOString(),
      tags: article.tags,
    },
  }}
  title={fullTitle}
  twitter={{
    card: "summary_large_image",
    creator: "@danestves",
    description,
    image: shareUrl,
    imageAlt: share.alt,
    site: "@danestves",
    title: fullTitle,
  }}
/>

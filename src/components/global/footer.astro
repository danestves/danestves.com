---
const siteLinks = [
  { text: "Work", href: "/projects/" },
  { text: "Studio", href: "/studio/" },
  { text: "Blog", href: "/blog/" },
  { text: "Now", href: "/now/" },
  { text: "Stack", href: "/stack/" },
  { text: "Socials", href: "/socials/" },
  { text: "Contact", href: "/contact/" },
  { text: "RSS", href: "/rss.xml" },
];

const elsewhere = [
  { text: "GitHub", href: "https://github.com/danestves" },
  { text: "X", href: "https://x.com/danestves" },
  { text: "LinkedIn", href: "https://www.linkedin.com/in/danestves/" },
  { text: "YouTube", href: "https://www.youtube.com/@danestves" },
];
---

<footer class="foot">
  <div class="shell foot__grid">
    <p class="foot__legal">© {new Date().getFullYear()} danestves LLC</p>
    <nav aria-label="Site" class="foot__links">
      {siteLinks.map((link) => <a href={link.href}>{link.text}</a>)}
    </nav>
    <nav aria-label="Elsewhere" class="foot__links">
      {elsewhere.map((link) => <a href={link.href} rel="me">{link.text}</a>)}
    </nav>
  </div>
</footer>

<style>
  .foot {
    margin-top: var(--section-gap);
    padding-block: var(--space-xl) var(--space-2xl);
    border-top: 1px solid var(--color-rule);
    font-size: var(--text-sm);
  }
  .foot__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-2xl);
    row-gap: var(--space-md);
  }
  .foot__legal {
    color: var(--color-muted);
  }
  .foot__links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-lg);
    row-gap: var(--space-xs);
  }
  .foot__links:last-child {
    margin-left: auto;
  }
  .foot__links a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    /* "X" alone is narrower than a 24px tap target */
    min-width: 24px;
    color: var(--color-ink-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .foot__links a:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }
  @media (max-width: 60rem) {
    .foot__links:last-child {
      margin-left: 0;
    }
  }
</style>

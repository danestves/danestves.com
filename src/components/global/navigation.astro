---
import Logo from "#/components/assets/logo.astro";
import ThemeToggle from "#/components/assets/theme-toggle.astro";

const navLinks = [
  { text: "Work", href: "/projects" },
  { text: "Studio", href: "/studio" },
  { text: "Blog", href: "/blog" },
];

const isCurrent = (href: string) => Astro.url.pathname === href || Astro.url.pathname.startsWith(`${href}/`);
---

<header class="nav">
  <div class="shell nav__bar">
    <a aria-label="danestves, home" class="wordmark" href="/">
      <Logo aria-hidden="true" class="mark" />
      <span>danestves</span>
    </a>
    <nav aria-label="Main" class="nav__links">
      {
        navLinks.map((link) => (
          <a aria-current={isCurrent(link.href) ? "page" : undefined} href={link.href}>
            {link.text}
          </a>
        ))
      }
    </nav>
    <div class="nav__end">
      <ThemeToggle />
      <a class="nav__mail" href="mailto:hi@danestves.com">hi@danestves.com</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky-nav);
    background: var(--color-paper);
    box-shadow: 0 1px 0 var(--color-rule);
  }
  .nav__bar {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    min-height: var(--nav-height);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 44px;
    font: 500 1.125rem/1 var(--font-display);
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--color-ink);
  }
  .wordmark :global(.mark) {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }
  .nav__links {
    display: flex;
    gap: var(--space-lg);
    font-size: 0.9375rem;
  }
  .nav__links a,
  .nav__mail {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ink-2);
    text-decoration: none;
    transition: color var(--dur-short) var(--ease-out);
  }
  .nav__links a:hover,
  .nav__mail:hover,
  .nav__links a[aria-current="page"] {
    color: var(--color-ink);
  }
  .nav__links a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .nav__end {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-left: auto;
    font-size: 0.9375rem;
  }
  @media (max-width: 40rem) {
    .nav__bar {
      gap: var(--space-md);
    }
    .nav__links {
      gap: var(--space-md);
    }
    .nav__mail {
      display: none;
    }
  }
  @media (max-width: 24rem) {
    .wordmark span {
      display: none;
    }
  }
</style>

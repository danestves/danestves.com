---

<div class="stack">
  {
    stack.map((section, index) => (
      <section aria-labelledby={`stack-${index}`} class="stack__group">
        <h2 id={`stack-${index}`}>{section.title}</h2>
        <ul class="rows">
          {section.items.map((item) => (
            <li class="tool">
              <img alt="" class="tool__logo" height="40" src={item.stackLogo.src} width="40" />
              <h3>{item.name}</h3>
              <p class="tool__about">{item.about}</p>
              <p class="tool__what">{item.description}</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .stack__group {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-columns);
    row-gap: var(--space-lg);
    align-items: start;
    padding-top: var(--section-gap-s);
  }
  .stack__group h2 {
    grid-column: 1 / span 3;
    font-size: var(--text-xl);
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .stack__group .rows {
    grid-column: 4 / -1;
  }
  .tool {
    display: grid;
    grid-template-columns: 40px minmax(0, 2fr) minmax(0, 5fr);
    column-gap: var(--space-lg);
    row-gap: var(--space-2xs);
    align-items: start;
    padding-block: var(--space-md);
  }
  .tool__logo {
    grid-row: 1 / span 2;
    width: 40px;
    height: 40px;
    border-radius: 9px;
    object-fit: cover;
  }
  .tool h3 {
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.4;
  }
  .tool__about {
    grid-column: 2;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .tool__what {
    grid-column: 3;
    grid-row: 1 / span 2;
    color: var(--color-ink-2);
  }
  @media (max-width: 60rem) {
    .stack__group h2,
    .stack__group .rows {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 40rem) {
    .tool {
      grid-template-columns: 40px minmax(0, 1fr);
    }
    .tool__what {
      grid-column: 1 / -1;
      grid-row: auto;
      margin-top: var(--space-xs);
    }
  }
</style>

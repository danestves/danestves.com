---
import { ClientRouter } from "astro:transitions";

import BaseHead from "#/components/fundations/head/base-head.astro";
import Seo from "#/components/fundations/head/seo.astro";
import Footer from "#/components/global/footer.astro";
import Navigation from "#/components/global/navigation.astro";

import "../styles/global.css";

const { seo } = Astro.props;
---

<html lang="en">
  <head>
    <!-- Sets data-theme before paint: the visitor's pick, else the system. Re-applied after every client-side navigation. -->
    <script is:inline>
      (() => {
        const applyTheme = () => {
          const stored = localStorage.getItem("theme");
          const system = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.setAttribute(
            "data-theme",
            stored === "light" || stored === "dark" ? stored : system,
          );
        };
        applyTheme();
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", applyTheme);
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>
    <noscript
      ><style is:inline>
        [data-needs-js] {
          display: none !important;
        }
      </style></noscript
    >
    <BaseHead />
    <Seo {...seo} />
    <ClientRouter />
    <script
      data-do-not-track="true"
      data-exclude-search="true"
      data-website-id="ba752a11-e024-4a9d-8934-47c20607d2e5"
      defer
      is:inline
      src="https://events.danestves.com/script.js"
      type="text/partytown"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Navigation />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>

<style is:global>
  html,
  body {
    overflow-x: clip;
  }
</style>

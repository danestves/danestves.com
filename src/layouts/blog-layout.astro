---
import type { CollectionEntry } from "astro:content";
import type { ComponentProps } from "astro/types";

import { getCollection } from "astro:content";

import PostRows from "#/components/blog/post-rows.astro";
import BaseLayout from "#/layouts/base-layout.astro";
import { breadcrumb, ids } from "#/lib/schema";

interface Props {
  frontmatter: CollectionEntry<"posts">["data"];
  seo: ComponentProps<typeof BaseLayout>["seo"];
}

const { frontmatter, seo } = Astro.props;
const morePosts = (await getCollection("posts", (post) => post.id !== Astro.params.slug))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const published = frontmatter.pubDate.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });

const pageUrl = Astro.url.href;
const jsonLd = [
  breadcrumb([
    ["Home", "/"],
    ["Blog", "/blog/"],
    [frontmatter.title, new URL(pageUrl).pathname],
  ]),
  {
    "@type": "BlogPosting",
    "@id": `${pageUrl}#post`,
    mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
    headline: frontmatter.title,
    description: frontmatter.description,
    image: [new URL(frontmatter.image?.url ?? "/og/index.jpg", Astro.site).href],
    datePublished: frontmatter.pubDate.toISOString(),
    dateModified: (frontmatter.updatedDate ?? frontmatter.pubDate).toISOString(),
    // Posts are Daniel's; a guest author gets an inline Person instead of his entity.
    author:
      frontmatter.author === "Daniel Esteves" ? { "@id": ids.person } : { "@type": "Person", name: frontmatter.author },
    publisher: { "@id": ids.org },
    isPartOf: { "@id": ids.website },
    keywords: frontmatter.tags.join(", "),
    inLanguage: "en",
  },
];
---

<BaseLayout jsonLd={jsonLd} seo={seo}>
  <article class="shell">
    <header class="post-head">
      <a class="post-head__back" href="/blog/">Blog</a>
      <h1>{frontmatter.title}</h1>
      <p class="lead">{frontmatter.description}</p>
    </header>

    <div class="post-body">
      <div class="prose"><slot /></div>
      <dl class="post-facts">
        <div>
          <dt>Published</dt>
          <dd><time class="num" datetime={frontmatter.pubDate.toISOString()}>{published}</time></dd>
        </div>
        <div><dt>By</dt><dd>{frontmatter.author}</dd></div>
        <div>
          <dt>Tags</dt>
          <dd class="post-facts__tags">{frontmatter.tags.map((tag) => <a href={`/blog/tags/${tag}/`}>{tag}</a>)}</dd>
        </div>
      </dl>
    </div>
  </article>

  {
    morePosts.length > 0 && (
      <section aria-labelledby="more-title" class="shell section">
        <div class="more-head">
          <h2 id="more-title">More posts</h2>
          <a class="text-link" href="/blog/">
            All posts
          </a>
        </div>
        <PostRows headingLevel="h3" posts={morePosts} />
      </section>
    )
  }
</BaseLayout>

<style>
  .post-head {
    display: grid;
    gap: var(--space-lg);
    max-width: 56rem;
    padding-top: var(--space-2xl);
  }
  .post-head__back {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ink-2);
  }
  .post-head h1 {
    font-size: var(--text-display-s);
    line-height: 1.05;
    overflow-wrap: break-word;
    min-width: 0;
    text-wrap: balance;
  }
  .post-body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-columns);
    row-gap: var(--space-xl);
    align-items: start;
    padding-top: var(--space-2xl);
  }
  .prose {
    grid-column: 1 / span 8;
  }
  .post-facts {
    grid-column: 10 / -1;
    grid-row: 1;
    display: grid;
    gap: var(--space-md);
    font-size: var(--text-sm);
  }
  .post-facts div {
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-rule);
  }
  .post-facts dt {
    color: var(--color-muted);
  }
  .post-facts dd {
    margin-top: var(--space-2xs);
  }
  .post-facts__tags {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-md);
  }
  .more-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }
  @media (max-width: 60rem) {
    .prose,
    .post-facts {
      grid-column: 1 / -1;
    }
    .post-facts {
      grid-row: auto;
    }
  }
</style>

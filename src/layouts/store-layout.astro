---
import type { CollectionEntry } from "astro:content";

import BaseLayout from "#/layouts/base-layout.astro";

interface Props {
  frontmatter: CollectionEntry<"store">["data"];
  seo: Record<string, unknown>;
}

const { frontmatter, seo } = Astro.props;
---

<BaseLayout seo={seo}>
  <article class="shell">
    <header class="page-head">
      <h1>{frontmatter.title}</h1>
      <div class="page-head__aside">
        <p class="lead">{frontmatter.description}</p>
        <p class="price num">${frontmatter.price}</p>
        <div class="actions">
          <a class="btn" href={frontmatter.checkout}>Buy {frontmatter.title}</a>
          <a class="text-link" href={frontmatter.preview}>Preview demo</a>
        </div>
      </div>
    </header>

    <ul class="shots">
      {
        [frontmatter.image, ...frontmatter.images].map((image) => (
          <li>
            <figure data-kind="product" data-slot={image.url}>
              <img alt={image.alt} height="1200" loading="lazy" src={image.url} width="1600" />
            </figure>
          </li>
        ))
      }
    </ul>

    <section aria-labelledby="features-title" class="section">
      <h2 class="visually-hidden" id="features-title">Features</h2>
      <dl class="rows features">
        {
          frontmatter.features.map((feature) => (
            <div>
              <dt>{feature.title}</dt>
              <dd>{feature.description}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <div class="store-body section">
      <div class="prose"><slot /></div>
      <dl class="store-facts">
        <div>
          <dt>Includes</dt>
          <dd><ul>{frontmatter.highlights.map((highlight) => <li>{highlight}</li>)}</ul></dd>
        </div>
        <div><dt>License</dt><dd>{frontmatter.license}</dd></div>
        <div><dt>Sold by</dt><dd>danestves LLC</dd></div>
      </dl>
    </div>
  </article>
</BaseLayout>

<style>
  h1 {
    overflow-wrap: break-word;
    min-width: 0;
    text-wrap: balance;
  }
  .price {
    font: 500 var(--text-display-s) / 1 var(--font-display);
    letter-spacing: -0.03em;
  }
  .shots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-columns);
    margin-top: var(--space-2xl);
  }
  .shots figure {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-card);
  }
  .features div {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-columns);
    row-gap: var(--space-xs);
    padding-block: var(--space-lg);
  }
  .features dt {
    grid-column: 1 / span 4;
    font-weight: 500;
  }
  .features dd {
    grid-column: 5 / span 6;
    color: var(--color-ink-2);
  }
  .store-body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-columns);
    row-gap: var(--space-xl);
    align-items: start;
  }
  .prose {
    grid-column: 1 / span 8;
  }
  .store-facts {
    grid-column: 10 / -1;
    grid-row: 1;
    display: grid;
    gap: var(--space-md);
    font-size: var(--text-sm);
  }
  .store-facts div {
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-rule);
  }
  .store-facts dt {
    color: var(--color-muted);
  }
  .store-facts dd {
    margin-top: var(--space-2xs);
    color: var(--color-ink-2);
  }
  @media (max-width: 60rem) {
    .features dt,
    .features dd,
    .prose,
    .store-facts {
      grid-column: 1 / -1;
    }
    .store-facts {
      grid-row: auto;
    }
  }
  @media (max-width: 40rem) {
    .shots {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

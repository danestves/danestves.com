---
import { getCollection } from "astro:content";

import PostRows from "#/components/blog/post-rows.astro";
import BaseLayout from "#/layouts/base-layout.astro";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags))];
  return uniqueTags.map((tag) => ({
    params: { tag },
    props: {
      posts: allPosts
        .filter((post) => post.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout
  seo={{
    title: `Blog posts tagged with "${tag}"`,
    description: `Find all the posts tagged with "${tag}".`,
    useTitleTemplate: true,
    // Thin while the blog is this small; also left out of the sitemap in astro.config.mjs.
    noindex: true,
  }}
>
  <div class="shell">
    <header class="page-head">
      <h1>{tag}</h1>
      <div class="page-head__aside">
        <p class="lead">{posts.length === 1 ? "1 post" : `${posts.length} posts`} tagged {tag}.</p>
        <p class="links"><a href="/blog/tags/">All tags</a><a href="/blog/">All posts</a></p>
      </div>
    </header>

    <section aria-label={`Posts tagged ${tag}`} class="section">
      <PostRows posts={posts} />
    </section>
  </div>
</BaseLayout>

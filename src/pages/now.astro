---
import BaseLayout from "#/layouts/base-layout.astro";

// Update this list, and the date under it, whenever the focus changes.
const now = [
  {
    what: "Working at ClickIT",
    detail: "My day job.",
    href: "https://www.clickittech.com",
  },
  {
    what: "Shipping Outlayr",
    detail: "On Google Play since 21 October 2026. The App Store version is next.",
    href: "/projects/outlayr",
  },
  {
    what: "Growing Vela",
    detail:
      "Version 2.4 added Body Forecast: likely symptoms, mood and energy for the next 7 days, learned on the phone.",
    href: "/projects/vela",
  },
  {
    what: "Keeping the packages current",
    detail: "remix-auth-auth0 and laravel-polar, plus contributions to PanelUI.",
    href: "/projects",
  },
  {
    what: "Sharing what I learn",
    detail: "On YouTube, on X and on this blog.",
    href: "/blog",
  },
];
---

<BaseLayout
  seo={{
    title: "Now",
    description: "What Daniel Esteves is working on right now.",
    useTitleTemplate: true,
  }}
>
  <div class="shell">
    <header class="page-head">
      <h1>Now</h1>
      <div class="page-head__aside">
        <p class="lead">What I am working on this month.</p>
      </div>
    </header>

    <section aria-label="Right now" class="section">
      <ul class="rows">
        {
          now.map((item) => (
            <li class="now">
              <h2>
                <a href={item.href}>{item.what}</a>
              </h2>
              <p>{item.detail}</p>
            </li>
          ))
        }
      </ul>
      <p class="updated">Last updated <time datetime="2026-10-24">24 October 2026</time>.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .now {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-columns);
    row-gap: var(--space-xs);
    align-items: baseline;
    padding-block: var(--space-lg);
  }
  .now h2 {
    grid-column: 1 / span 4;
    font-size: var(--text-title);
    line-height: 1.2;
    letter-spacing: -0.015em;
    max-width: none;
  }
  .now h2 a {
    text-decoration: none;
  }
  .now h2 a:hover {
    text-decoration: underline;
  }
  .now p {
    grid-column: 5 / span 6;
    color: var(--color-ink-2);
  }
  .updated {
    margin-top: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  @media (max-width: 60rem) {
    .now h2,
    .now p {
      grid-column: 1 / -1;
    }
  }
</style>

---
import { getCollection, render } from "astro:content";

import ProjectsLayout from "#/layouts/projects-layout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const paths = projects.map((page) => {
    return {
      params: { slug: page.id },
      props: { page },

      trailingSlash: false,
    };
  });
  return paths;
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<ProjectsLayout
  frontmatter={page.data}
  seo={{
    title: page.data.seoTitle ?? page.data.title,
    useTitleTemplate: true,
    description: page.data.subtitle,
    image: page.data.image,
    // Archived projects keep their page for old links but leave search.
    noindex: page.data.archived,
  }}
>
  <Content />
</ProjectsLayout>

---
import { getCollection } from "astro:content";

import CopyCommand from "#/components/fundations/elements/copy-command.astro";
import BaseLayout from "#/layouts/base-layout.astro";

const projects = (await getCollection("projects", ({ data }) => !data.archived)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const apps = projects.filter((project) => project.data.kind === "app");
const packages = projects.filter((project) => project.data.kind === "package");
---

<BaseLayout
  seo={{
    title: "Apps and open source",
    description:
      "The apps danestves LLC publishes, Outlayr and Vela, and the open source packages Daniel Esteves maintains.",
    useTitleTemplate: true,
  }}
>
  <div class="shell">
    <header class="page-head">
      <h1>Apps we publish, code we share</h1>
      <div class="page-head__aside">
        <p class="lead">Two apps from danestves LLC, and the packages Daniel keeps on GitHub.</p>
      </div>
    </header>

    {
      apps.map((app) => {
        const wide = app.data.screens.some((screen) => screen.width > screen.height);
        return (
          <article aria-labelledby={`${app.id}-title`} class="section app">
            <div class="app__text">
              <img alt="" class="app__icon" height="64" src={app.data.logo.url} width="64" />
              <h2 id={`${app.id}-title`}>
                <a href={`/projects/${app.id}/`}>{app.data.title}</a>
              </h2>
              <p class="lead">{app.data.subtitle}</p>
              <p class="links">
                {app.data.links.map((link) => (
                  <a href={link.url}>{link.label}</a>
                ))}
              </p>
              <a class="text-link" href={`/projects/${app.id}/`}>
                How {app.data.title} works
              </a>
            </div>
            <ul class:list={["app__screens", { "app__screens--wide": wide }]}>
              {app.data.screens.slice(0, wide ? 1 : 3).map((screen) => (
                <li>
                  <figure
                    data-kind="product"
                    data-slot={screen.url}
                    style={`aspect-ratio: ${screen.width} / ${screen.height}`}
                  >
                    <img alt={screen.alt} height={screen.height} loading="lazy" src={screen.url} width={screen.width} />
                  </figure>
                </li>
              ))}
            </ul>
          </article>
        );
      })
    }

    <section aria-labelledby="oss-title" class="section">
      <div class="section-head">
        <h2 id="oss-title">Open source</h2>
        <p class="lead">Sign-in for Remix and payments for Laravel.</p>
      </div>
      <ul class="rows">
        {
          packages.map((pkg) => (
            <li class="pkg">
              <h3>
                <a href={`/projects/${pkg.id}/`}>{pkg.data.title}</a>
              </h3>
              <p class="pkg__what">{pkg.data.subtitle}</p>
              <p class="pkg__year num">Since {pkg.data.pubDate.getFullYear()}</p>
              {pkg.data.install && <CopyCommand command={pkg.data.install} />}
            </li>
          ))
        }
      </ul>
      <p class="more"><a href="https://github.com/danestves?tab=repositories">Everything else on GitHub</a></p>
    </section>
  </div>
</BaseLayout>

<style>
  .app {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-columns);
    row-gap: var(--space-xl);
    align-items: start;
  }
  .app__text {
    grid-column: 1 / span 4;
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }
  .app__icon {
    width: 64px;
    height: 64px;
  }
  .app h2 {
    font-size: var(--text-display);
    line-height: 1;
    text-wrap: balance;
  }
  .app h2 a {
    text-decoration: none;
  }
  .app h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .app__screens {
    grid-column: 6 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap-columns);
  }
  .app__screens--wide {
    grid-template-columns: minmax(0, 1fr);
  }
  .app__screens figure {
    border-radius: var(--radius-screen);
  }
  .app__screens--wide figure {
    border-radius: var(--radius-card);
  }

  .pkg {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-columns);
    row-gap: var(--space-sm);
    align-items: center;
    padding-block: var(--space-lg);
  }
  .pkg h3 {
    grid-column: 1 / span 3;
  }
  .pkg h3 a {
    text-decoration: none;
  }
  .pkg h3 a:hover {
    text-decoration: underline;
  }
  .pkg__what {
    grid-column: 4 / span 4;
    color: var(--color-ink-2);
  }
  .pkg__year {
    grid-column: 8 / span 1;
    color: var(--color-muted);
  }
  .pkg :global(.cmd) {
    grid-column: 9 / -1;
  }
  .more {
    margin-top: var(--space-lg);
  }
  .more a {
    font-weight: 500;
  }

  @media (max-width: 60rem) {
    .app__text,
    .app__screens {
      grid-column: 1 / -1;
    }
    .pkg h3,
    .pkg__what,
    .pkg__year,
    .pkg :global(.cmd) {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 40rem) {
    .app__screens:not(.app__screens--wide) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .app__screens:not(.app__screens--wide) li:nth-child(3) {
      display: none;
    }
  }
</style>

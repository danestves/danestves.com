---
import BrandYoutubeIcon from "virtual:icons/tabler/brand-youtube";

import Discord from "#/images/sociallogos/discord.svg";
import Github from "#/images/sociallogos/github.svg";
import Linkedin from "#/images/sociallogos/linkedin.svg";
import Spotify from "#/images/sociallogos/spotify.svg";
import X from "#/images/sociallogos/x.svg";
import BaseLayout from "#/layouts/base-layout.astro";

const sections = [
  {
    title: "Development",
    items: [
      {
        stackLogo: Github,
        name: "GitHub",
        username: "@danestves",
        url: "https://github.com/danestves",
      },
    ],
  },
  {
    title: "Social media",
    items: [
      {
        stackLogo: Linkedin,
        name: "LinkedIn",
        username: "@danestves",
        url: "https://www.linkedin.com/in/danestves/",
      },
      {
        stackLogo: X,
        name: "X",
        username: "@danestves",
        url: "https://x.com/danestves",
      },
      {
        // No vendor file for YouTube; the Tabler icon stands in.
        stackLogo: null,
        name: "YouTube",
        username: "@danestves",
        url: "https://www.youtube.com/@danestves",
      },
    ],
  },
  {
    title: "Other",
    items: [
      {
        stackLogo: Spotify,
        name: "Spotify",
        username: "@danestves",
        url: "https://open.spotify.com/user/danestves",
      },
      {
        stackLogo: Discord,
        name: "Discord",
        username: "@danestves",
        url: "https://discord.com/invite/danestves",
      },
    ],
  },
];
---

<BaseLayout
  seo={{
    title: "Socials",
    description: "Where to find Daniel Esteves online.",
    useTitleTemplate: true,
  }}
>
  <div class="shell">
    <header class="page-head">
      <h1>Find me online</h1>
      <div class="page-head__aside">
        <p class="lead">I am @danestves everywhere.</p>
      </div>
    </header>

    {
      sections.map((section) => (
        <section aria-labelledby={`socials-${section.title}`} class="group">
          <h2 id={`socials-${section.title}`}>{section.title}</h2>
          <ul class="rows">
            {section.items.map((item) => (
              <li>
                <a class="profile" href={item.url}>
                  {item.stackLogo ? (
                    <img alt="" class="profile__logo" height="32" src={item.stackLogo.src} width="32" />
                  ) : (
                    <BrandYoutubeIcon aria-hidden="true" class="profile__logo" />
                  )}
                  <span class="profile__name">{item.name}</span>
                  <span class="profile__handle">{item.username}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .group {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-columns);
    row-gap: var(--space-lg);
    align-items: start;
    padding-top: var(--section-gap-s);
  }
  .group h2 {
    grid-column: 1 / span 3;
    font-size: var(--text-xl);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .group .rows {
    grid-column: 4 / span 6;
  }
  .profile {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) auto;
    column-gap: var(--space-md);
    align-items: center;
    min-height: 64px;
    text-decoration: none;
  }
  .profile__logo {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-pill);
  }
  .profile__name {
    font-weight: 500;
  }
  .profile:hover .profile__name {
    text-decoration: underline;
  }
  .profile__handle {
    color: var(--color-muted);
  }
  @media (max-width: 60rem) {
    .group h2,
    .group .rows {
      grid-column: 1 / -1;
    }
  }
</style>

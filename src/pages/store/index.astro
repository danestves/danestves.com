---
import { getCollection } from "astro:content";

import BaseLayout from "#/layouts/base-layout.astro";

const allProducts = await getCollection("store");
---

<BaseLayout
  seo={{
    title: "Store",
    description: "Plugins and tools sold by danestves LLC.",
    useTitleTemplate: true,
  }}
>
  <div class="shell">
    <header class="page-head">
      <h1>Store</h1>
      <div class="page-head__aside">
        <p class="lead">Plugins and tools sold by danestves LLC.</p>
      </div>
    </header>

    <section aria-label="Products" class="section">
      <ul class="rows">
        {
          allProducts.map((product) => (
            <li class="product">
              <figure data-kind="product" data-slot={product.id}>
                <img
                  alt={product.data.image.alt}
                  height="1200"
                  loading="lazy"
                  src={product.data.image.url}
                  width="1600"
                />
              </figure>
              <div class="product__text">
                <h2>
                  <a href={`/store/${product.id}`}>{product.data.title}</a>
                </h2>
                <p>{product.data.description}</p>
                <p class="product__price num">${product.data.price}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .product {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-columns);
    row-gap: var(--space-lg);
    align-items: center;
    padding-block: var(--space-xl);
  }
  .product figure {
    grid-column: 1 / span 6;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-card);
  }
  .product__text {
    grid-column: 8 / -1;
    display: grid;
    gap: var(--space-md);
  }
  .product h2 {
    overflow-wrap: break-word;
    min-width: 0;
    text-wrap: balance;
  }
  .product h2 a {
    text-decoration: none;
  }
  .product h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .product__text p {
    color: var(--color-ink-2);
  }
  .product__text .product__price {
    font: 500 var(--text-display-s) / 1 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }
  @media (max-width: 60rem) {
    .product figure,
    .product__text {
      grid-column: 1 / -1;
    }
  }
</style>

---
import BaseLayout from "#/layouts/base-layout.astro";
import { breadcrumb, ids } from "#/lib/schema";

// What the studio builds; every line points at shipped work.
const builds = [
  {
    what: "Phone apps",
    how: "Expo and React Native for iOS and Android, or SwiftUI for native iOS.",
    proof: [
      { label: "Outlayr", href: "/projects/outlayr/" },
      { label: "Vela", href: "/projects/vela/" },
      { label: "numberflow", href: "https://github.com/danestves/numberflow" },
    ],
  },
  {
    what: "Web apps",
    how: "React, Laravel and Astro.",
    proof: [
      { label: "tryoutlayr.com", href: "https://tryoutlayr.com" },
      { label: "hellovela.app", href: "https://hellovela.app" },
    ],
  },
  {
    what: "Payments and sign-in",
    how: "Subscriptions and checkout on Polar, and auth for Remix.",
    proof: [
      { label: "laravel-polar", href: "/projects/laravel-polar/" },
      { label: "remix-auth-auth0", href: "/projects/remix-auth-auth0/" },
    ],
  },
];

const apps = [
  {
    name: "Outlayr",
    href: "/projects/outlayr/",
    icon: "/projects/outlayr-icon.webp",
    shot: {
      src: "/projects/outlayr-log.webp",
      width: 880,
      height: 1912,
      alt: "Outlayr’s Log: this month’s net and accounts",
    },
    line: "An expense tracker where a purchase is one sentence.",
    facts: [
      { label: "Problem", text: "Logging an expense takes too many taps, so people stop." },
      { label: "What we built", text: "Type it, say it, or scan the receipt. Budgets that project where the month ends." },
      { label: "Stack", text: "Expo, React Native and Convex, local-first." },
      { label: "Shipped", text: "Google Play on 21 October 2026, in English and Spanish. App Store next." },
    ],
  },
  {
    name: "Vela",
    href: "/projects/vela/",
    icon: "/projects/vela-icon.webp",
    shot: { src: "/projects/vela-calendar.webp", width: 1600, height: 1000, alt: "Vela’s calendar: the cycle by day" },
    line: "A period tracker that encrypts before it syncs.",
    facts: [
      { label: "Problem", text: "Cycle data is sensitive, and most trackers can read it." },
      { label: "What we built", text: "Sync where every record is encrypted on the phone, with keys the server never holds." },
      { label: "Stack", text: "Expo and React Native." },
      { label: "Shipped", text: "App Store on 22 April 2026, and Google Play." },
    ],
  },
];
const steps = [
  { name: "Scope", what: "A call, then a written plan: what ships first, the stack, the price and the dates." },
  { name: "Build", what: "A build you can install every week, through TestFlight and Google Play testing." },
  { name: "Ship", what: "Store listings, review and release." },
];

const jsonLd = [
  breadcrumb([
    ["Home", "/"],
    ["Studio", "/studio/"],
  ]),
  {
    "@type": "Service",
    "@id": "https://danestves.com/studio/#service",
    name: "Mobile and web app development",
    serviceType: "App development",
    description: "danestves LLC designs, builds and ships iOS, Android and web apps for clients.",
    provider: { "@id": ids.org },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "What we build",
      itemListElement: builds.map((build) => ({
        "@type": "Offer",
        itemOffered: { "@type": "Service", name: build.what, description: build.how },
      })),
    },
  },
];
---

<BaseLayout
  jsonLd={jsonLd}
  seo={{
    title: "Expo and React Native app development",
    description:
      "danestves LLC builds iOS, Android and web apps for clients, with the same hands that ship Outlayr and Vela.",
    useTitleTemplate: true,
  }}
>
  <div class="shell">
    <header class="page-head">
      <h1>Expo and React Native apps for iOS, Android and the web</h1>
      <div class="page-head__aside">
        <p class="lead">danestves LLC designs, builds and ships iOS, Android and web apps for clients.</p>
        <div class="actions">
          <a class="btn" href="/contact/">Start a project</a>
          <a class="text-link" href="/contact/">Use the contact form</a>
        </div>
      </div>
    </header>

    <section aria-labelledby="builds-title" class="section">
      <div class="section-head">
        <h2 id="builds-title">What we build</h2>
      </div>
      <ul class="rows">
        {
          builds.map((build) => (
            <li class="build">
              <h3>{build.what}</h3>
              <p class="build__how">{build.how}</p>
              <p class="build__proof">
                {build.proof.map((link) => (
                  <a href={link.href}>{link.label}</a>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="shipped-title" class="section">
      <div class="section-head">
        <h2 id="shipped-title">Two apps we shipped, and how</h2>
      </div>
      {
        apps.map((app) => (
          <article class="case">
            <figure
              class:list={["case__shot", { "case__shot--wide": app.shot.width > app.shot.height }]}
              data-kind="product"
              data-slot={app.shot.src}
              style={`aspect-ratio: ${app.shot.width} / ${app.shot.height}`}
            >
              <img alt={app.shot.alt} height={app.shot.height} loading="lazy" src={app.shot.src} width={app.shot.width} />
            </figure>
            <div class="case__body">
              <h3>
                <img alt="" height="40" src={app.icon} width="40" />
                <a href={app.href}>{app.name}</a>
              </h3>
              <p class="lead">{app.line}</p>
              <dl class="case__facts">
                {app.facts.map((fact) => (
                  <div>
                    <dt>{fact.label}</dt>
                    <dd>{fact.text}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </article>
        ))
      }
    </section>

    <section aria-labelledby="steps-title" class="section">
      <div class="section-head">
        <h2 id="steps-title">How a project runs</h2>
      </div>
      <ol class="rows">
        {
          steps.map((step) => (
            <li class="build">
              <h3>{step.name}</h3>
              <p class="build__how">{step.what}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="company-title" class="section company">
      <figure class="company__portrait" data-slot="daniel">
        <img alt="Daniel Esteves" height="800" loading="lazy" src="/images/daniel.jpg" width="800" />
      </figure>
      <div class="company__who">
        <h2 id="company-title">The company</h2>
        <p class="lead">
          danestves LLC is the studio of Daniel Esteves, a developer from Venezuela, writing software since 2016.
        </p>
      </div>
      <dl class="company__facts">
        <div><dt>Legal name</dt><dd>danestves LLC</dd></div>
        <div>
          <dt>Address</dt>
          <dd><address>651 N Broad St, Suite 201<br />Middletown, DE 19709, USA</address></dd>
        </div>
        <div><dt>Email</dt><dd><a href="mailto:hi@danestves.com">hi@danestves.com</a></dd></div>
        <div><dt>Daniel worked with</dt><dd>Platzi, Seeed, Reworth and Brightwell</dd></div>
      </dl>
    </section>

    <section aria-labelledby="close-title" class="section close">
      <h2 id="close-title">Tell us what it should do</h2>
      <p class="lead">Who it is for, and when it should ship.</p>
      <div class="actions">
        <a class="btn" href="mailto:hi@danestves.com?subject=A%20project">hi@danestves.com</a>
        <a class="text-link" href="/contact/">Use the contact form</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .build {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-columns);
    row-gap: var(--space-xs);
    padding-block: var(--space-lg);
    align-items: baseline;
  }
  .build h3 {
    grid-column: 1 / span 3;
  }
  .build__how {
    grid-column: 4 / span 5;
    color: var(--color-ink-2);
  }
  .build__proof {
    grid-column: 9 / -1;
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-md);
  }
  .build__proof a {
    color: var(--color-ink);
  }

  /* Each shipped app as a short case study: its screen beside what it solved and how */
  .case {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-columns);
    row-gap: var(--space-lg);
    align-items: start;
    padding-block: var(--space-xl);
    border-top: 1px solid var(--color-ink);
  }
  .case__shot {
    grid-column: 1 / span 3;
    border-radius: var(--radius-screen);
  }
  .case__shot--wide {
    grid-column: 1 / span 4;
    border-radius: var(--radius-card);
  }
  .case__body {
    grid-column: 5 / -1;
    display: grid;
    gap: var(--space-md);
  }
  .case h3 {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-display-s);
    line-height: 1;
  }
  .case h3 img {
    width: 40px;
    height: 40px;
  }
  .case h3 a {
    text-decoration: none;
  }
  .case h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .case__facts div {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    column-gap: var(--space-lg);
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--color-rule);
  }
  .case__facts dt {
    color: var(--color-muted);
  }
  .case__facts dd {
    color: var(--color-ink-2);
  }

  .company {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-columns);
    row-gap: var(--space-xl);
    align-items: start;
  }
  .company__portrait {
    grid-column: 1 / span 3;
    aspect-ratio: 1;
    border-radius: var(--radius-card);
  }
  .company__who {
    grid-column: 4 / span 5;
    display: grid;
    gap: var(--space-lg);
  }
  .company__facts {
    grid-column: 9 / -1;
    display: grid;
    gap: var(--space-md);
  }
  .company__facts div {
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-rule);
  }
  .company__facts dt {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .company__facts dd {
    margin-top: var(--space-2xs);
  }
  .company__facts address {
    font-style: normal;
  }

  .close {
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }

  @media (max-width: 60rem) {
    .build h3,
    .build__how,
    .build__proof,
    .company__who,
    .company__facts {
      grid-column: 1 / -1;
    }
    .company__portrait {
      grid-column: 1 / span 6;
    }
  }
  @media (max-width: 40rem) {
    .case__shot {
      grid-column: 1 / span 6;
    }
    .case__shot--wide,
    .case__body {
      grid-column: 1 / -1;
    }
    .case__facts div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
